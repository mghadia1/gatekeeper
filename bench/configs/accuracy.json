{
  "default_timeout": "5s",
  "backends": {
    "users": {
      "url": "http://users-1:9000",
      "retries": 1
    }
  },
  "routes": [
    {
      "match": "GET /users/{id}",
      "backend": "users"
    }
  ],
  "rate_limit": {
    "requests_per_second": 50,
    "burst": 50,
    "store": "redis",
    "redis_url": "redis://redis:6379/0",
    "on_store_error": "allow"
  }
}
